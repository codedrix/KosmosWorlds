{
  "name": "kosmos-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "A small service on the CEO's PC that lets Kosmos worlds (Mission Control first) start and steer Claude Code jobs. Localhost only; reached through a tunnel the CEO sets up.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "agent-bridge": "dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "start": "node dist/src/main.js serve",
    "set-passphrase": "node dist/src/main.js set-passphrase",
    "kill": "node dist/src/main.js kill",
    "unkill": "node dist/src/main.js unkill",
    "status": "node dist/src/main.js status",
    "demo": "node dist/src/main.js serve --adapter fake",
    "unlock": "node dist/src/main.js unlock",
    "init": "node dist/src/main.js init",
    "make-relay-secret": "node dist/src/main.js make-relay-secret"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.3"
  }
}
