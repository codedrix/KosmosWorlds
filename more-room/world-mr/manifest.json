    "host_api": 4
  },
  "network": {
    "connect": [
      "https://more-room-bridge.micknerks.workers.dev"
    ],
    "purpose": "Reads your day (calendar, messages, tasks) from the bridge on your own PC, and sends back your presses.",
    "privacy_url": "https://more-room-bridge.micknerks.workers.dev/privacy",
    "required": false
  },
  "assets": {
    "gltf": "world.glb",
    "wasm": "world.wasm",
    "audio": [
      "tick.wav"
    ]
  },
  "presentation": {
    "mode": "immersive-ar",
    "blend": "alpha-blend",
    "requiredFeatures": [],
    "optionalFeatures": []
  }
