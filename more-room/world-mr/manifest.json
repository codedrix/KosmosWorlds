    "version": "1.0.0",
    "spawn_point": {
      "x": 0,
      "y": 0,
      "z": 1.1
    },
    "sky": "void"
  },
  "capabilities": [
    "scene_read",
    "scene_write",
    "transform",
    "events",
    "ui_basic",
    "audio",
    "network"
  ],
